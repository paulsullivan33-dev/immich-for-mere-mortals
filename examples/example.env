# Specimen only - the settings chapter 3 talks about, with a
# placeholder password. This is the shape of the project's
# example.env for Immich v3.3.5, trimmed to the lines the guide
# discusses. Never use this password; never use ANY password
# printed in a book.

# Where the uploaded photos live
UPLOAD_LOCATION=./library

# Where the database files live (local SSD, never a network share)
DB_DATA_LOCATION=./postgres

# Which release to run - pinned on purpose (chapter 3)
IMMICH_VERSION=v3.3.5

# The database's own password. Letters and digits only.
DB_PASSWORD=<redacted>

# The values below this line do not need to be changed
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
